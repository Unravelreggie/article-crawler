# Copy to server-local /home/sinopv/pv_reginald/article-crawler/.env (mode 600).
BIND_IP=127.0.0.1
DATA_ROOT=/data/apps/article-crawler
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql+psycopg://literature:replace-with-random-hex@db:5432/literature
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=replace-with-random-hex
S3_SECRET_KEY=replace-with-random-hex
S3_BUCKET=literature
CONTACT_EMAIL=you@example.org
NCBI_API_KEY=
OPENALEX_API_KEY=
MAX_UPLOAD_MB=25
ALLOW_FAKE_IP_DNS=false
API_IMAGE=ghcr.io/unravelreggie/article-crawler-api:sha-REPLACE
WEB_IMAGE=ghcr.io/unravelreggie/article-crawler-web:sha-REPLACE
POSTGRES_IMAGE=ghcr.io/unravelreggie/article-crawler-postgres:sha-REPLACE
REDIS_IMAGE=ghcr.io/unravelreggie/article-crawler-redis:sha-REPLACE
RUSTFS_IMAGE=ghcr.io/unravelreggie/article-crawler-rustfs:sha-REPLACE
